<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Slås ihop med den Info.plist som Xcode genererar. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>sv</string>
	</array>
	<!-- Nycklar från Secrets.xcconfig (gitignorerad). Tomma eller ej ersatta värden räknas som saknade. -->
	<key>TMDBReadAccessToken</key>
	<string>$(TMDB_READ_TOKEN)</string>
	<key>OMDbAPIKey</key>
	<string>$(OMDB_API_KEY)</string>
	<key>OpenSubtitlesAPIKey</key>
	<string>$(OPENSUBTITLES_API_KEY)</string>
	<!-- iCloud-synk inbyggd? Styrs av ICLOUD_SYNC_ENABLED (standard NO). -->
	<key>SyncEnabled</key>
	<string>$(ICLOUD_SYNC_ENABLED)</string>
	<key>CloudKitContainerIdentifier</key>
	<string>$(CLOUDKIT_CONTAINER)</string>
	<!-- IPTV-leverantörer serverar ofta bara http. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
</dict>
</plist>
