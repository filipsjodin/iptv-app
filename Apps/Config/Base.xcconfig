// Gemensamma bygginställningar för IPTV-apparna (iOS och tvOS).
// Signering: DEVELOPMENT_TEAM lämnas tomt här och sätts lokalt i Xcode. CI bygger med CODE_SIGNING_ALLOWED=NO.

MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
DEVELOPMENT_TEAM =
SWIFT_VERSION = 6.0

// API-nycklar (fylls i via Secrets.xcconfig, som aldrig checkas in). Läses via Info.plist
// (TMDBReadAccessToken, OMDbAPIKey, OpenSubtitlesAPIKey). Tomma värden betyder att funktionen är avstängd.
TMDB_READ_TOKEN =
OMDB_API_KEY =
OPENSUBTITLES_API_KEY =

// iCloud-synk av profiler, framsteg och inställningar. NO (standard) = inget CloudKit, inga entitlements och
// ingen synk: appen byggs och signeras som vanligt utan betalt utvecklarkonto. YES läses som Info.plist-nyckeln
// SyncEnabled; synk kräver dessutom ett betalt konto, en iCloud-container och motsvarande entitlements.
ICLOUD_SYNC_ENABLED = NO
// Entitlements-fil för synkbygget. TOM (standard) = ingen entitlements-fil refereras alls, och appen signeras som
// vanligt med ett gratis personligt team. Sync.xcconfig (se Sync.xcconfig.template) sätter den till
// Config/Sync.entitlements.
SYNC_ENTITLEMENTS =
// CloudKit-container (läses som Info.plist-nyckeln CloudKitContainerIdentifier; bara en sträng, ofarlig utan synk).
CLOUDKIT_CONTAINER = iCloud.se.sjodin.iptv

#include? "Secrets.xcconfig"
#include? "Sync.xcconfig"
